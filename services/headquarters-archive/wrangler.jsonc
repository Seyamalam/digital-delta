{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digital-delta-headquarters-archive",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://digital-delta-headquarters.vercel.app"
  },
  "d1_databases": [
    {
      "binding": "HQ_DB",
      "database_name": "digital-delta-hq",
      "database_id": "a40af817-c888-4081-9124-cf7d921e1668",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ARCHIVE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
