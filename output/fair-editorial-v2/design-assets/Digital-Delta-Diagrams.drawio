1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCDC6;align=left;verticalAlign=top;fontFamily=Arial;"><mxGeometry x="840" y="60" width="340" height="230" as="geometry"/></mxCell><mxCell id="d" value="&lt;div style=&quot;font-family:Arial;padding:12px;text-align:left&quot;&gt;&lt;div style=&quot;font-size:18px;color:#123D38&quot;&gt;DEPLOYMENT RESPONSIBILITY&lt;/div&gt;&lt;div style=&quot;font-size:26px;font-weight:bold;margin-top:10px&quot;&gt;Keep the system ready between events&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.3;margin-top:10px&quot;&gt;Training, devices, maps, credentials and support&lt;/div&gt;&lt;/div&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCDC6;align=left;verticalAlign=top;fontFamily=Arial;"><mxGeometry x="280" y="410" width="640" height="150" as="geometry"/></mxCell><mxCell id="label1" value="Buyer hypothesis. Interviews and willingness to pay remain unvalidated." parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#A96827;"><mxGeometry x="20" y="6" width="1160" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Each adoption step needs a decision owner" id="09-route-to-market"><mxGraphModel dx="1200" dy="600" grid="1" page="1" pageScale="1" pageWidth="1200" pageHeight="600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="edge0" parent="1" source="a" target="b" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=3;strokeColor=#216E75;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" parent="1" source="b" target="c" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=3;strokeColor=#216E75;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" parent="1" source="c" target="d" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=3;strokeColor=#216E75;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a" value="&lt;div style=&quot;font-family:Arial;padding:12px;text-align:left&quot;&gt;&lt;div style=&quot;font-size:18px;color:#123D38&quot;&gt;01  DISCOVERY&lt;/div&gt;&lt;div style=&quot;font-size:26px;font-weight:bold;margin-top:10px&quot;&gt;Map the workflow&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.3;margin-top:10px&quot;&gt;Find a sponsor and&lt;br&gt;operational owner.&lt;br&gt;Review procedures.&lt;/div&gt;&lt;/div&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCDC6;align=left;verticalAlign=top;fontFamily=Arial;"><mxGeometry x="20" y="80" width="260" height="235" as="geometry"/></mxCell><mxCell id="b" value="&lt;div style=&quot;font-family:Arial;padding:12px;text-align:left&quot;&gt;&lt;div style=&quot;font-size:18px;color:#216E75&quot;&gt;02  AGREEMENT&lt;/div&gt;&lt;div style=&quot;font-size:26px;font-weight:bold;margin-top:10px&quot;&gt;Scope the exercise&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.3;margin-top:10px&quot;&gt;Define data authority,&lt;br&gt;acceptance criteria&lt;br&gt;and cost.&lt;/div&gt;&lt;/div&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCDC6;align=left;verticalAlign=top;fontFamily=Arial;"><mxGeometry x="320" y="80" width="260" height="235" as="geometry"/></mxCell><mxCell id="c" value="&lt;div style=&quot;font-family:Arial;padding:12px;text-align:left&quot;&gt;&lt;div style=&quot;font-size:18px;color:#216E75&quot;&gt;03  VALIDATION&lt;/div&gt;&lt;div style=&quot;font-size:26px;font-weight:bold;margin-top:10px&quot;&gt;Test performance&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.3;margin-top:10px&quot;&gt;Test physical devices&lt;br&gt;and bilingual tasks&lt;br&gt;against a baseline.&lt;/div&gt;&lt;/div&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCDC6;align=left;verticalAlign=top;fontFamily=Arial;"><mxGeometry x="620" y="80" width="260" height="235" as="geometry"/></mxCell><mxCell id="d" value="&lt;div style=&quot;font-family:Arial;padding:12px;text-align:left&quot;&gt;&lt;div style=&quot;font-size:18px;color:#123D38&quot;&gt;04  ADOPTION&lt;/div&gt;&lt;div style=&quot;font-size:26px;font-weight:bold;margin-top:10px&quot;&gt;Review evidence&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.3;margin-top:10px&quot;&gt;Go, revise or stop.&lt;br&gt;Agree support before&lt;br&gt;expanding deployment.&lt;/div&gt;&lt;/div&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCDC6;align=left;verticalAlign=top;fontFamily=Arial;"><mxGeometry x="920" y="80" width="260" height="235" as="geometry"/></mxCell><mxCell id="label3" value="Entry offer: a supervised preparedness exercise" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=31;fontColor=#123D38;"><mxGeometry x="20" y="369" width="1160" height="39" as="geometry"/></mxCell><mxCell id="label4" value="Revenue hypothesis: scoped setup and training, followed by agreed readiness support." parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#576B6D;"><mxGeometry x="20" y="430" width="1160" height="32" as="geometry"/></mxCell><mxCell id="label5" value="No current contract, institutional endorsement or revenue is claimed." parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#A96827;"><mxGeometry x="20" y="487" width="1160" height="31" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A twelve week exercise creates an adoption decision" id="10-pilot-milestones"><mxGraphModel dx="1200" dy="600" grid="1" page="1" pageScale="1" pageWidth="1200" pageHeight="600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="edge0" parent="1" source="a" target="b" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=3;strokeColor=#216E75;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" parent="1" source="b" target="c" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=3;strokeColor=#216E75;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" parent="1" source="c" target="d" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=3;strokeColor=#216E75;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a" value="&lt;div style=&quot;font-family:Arial;padding:12px;text-align:left&quot;&gt;&lt;div style=&quot;font-size:18px;color:#123D38&quot;&gt;WEEKS 1–2&lt;/div&gt;&lt;div style=&quot;font-size:26px;font-weight:bold;margin-top:10px&quot;&gt;Agree ownership&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.3;margin-top:10px&quot;&gt;Sponsor and workflow&lt;br&gt;Phone selection&lt;br&gt;Acceptance criteria&lt;/div&gt;&lt;/div&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCDC6;align=left;verticalAlign=top;fontFamily=Arial;"><mxGeometry x="20" y="70" width="260" height="240" as="geometry"/></mxCell><mxCell id="b" value="&lt;div style=&quot;font-family:Arial;padding:12px;text-align:left&quot;&gt;&lt;div style=&quot;font-size:18px;color:#216E75&quot;&gt;WEEKS 3–5&lt;/div&gt;&lt;div style=&quot;font-size:26px;font-weight:bold;margin-top:10px&quot;&gt;Test real phones&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.3;margin-top:10px&quot;&gt;Relay and recovery&lt;br&gt;Camera QR verification&lt;br&gt;Battery and latency&lt;/div&gt;&lt;/div&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCDC6;align=left;verticalAlign=top;fontFamily=Arial;"><mxGeometry x="320" y="70" width="260" height="240" as="geometry"/></mxCell><mxCell id="c" value="&lt;div style=&quot;font-family:Arial;padding:12px;text-align:left&quot;&gt;&lt;div style=&quot;font-size:18px;color:#216E75&quot;&gt;WEEKS 6–8&lt;/div&gt;&lt;div style=&quot;font-size:26px;font-weight:bold;margin-top:10px&quot;&gt;Observe the users&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.3;margin-top:10px&quot;&gt;Bangla and English&lt;br&gt;Accessibility review&lt;br&gt;Rehearsal and baseline&lt;/div&gt;&lt;/div&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCDC6;align=left;verticalAlign=top;fontFamily=Arial;"><mxGeometry x="620" y="70" width="260" height="240" as="geometry"/></mxCell><mxCell id="d" value="&lt;div style=&quot;font-family:Arial;padding:12px;text-align:left&quot;&gt;&lt;div style=&quot;font-size:18px;color:#123D38&quot;&gt;WEEKS 9–12&lt;/div&gt;&lt;div style=&quot;font-size:26px;font-weight:bold;margin-top:10px&quot;&gt;Review adoption&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.3;margin-top:10px&quot;&gt;Shadow exercise&lt;br&gt;Incident and cost review&lt;br&gt;Go, revise or stop&lt;/div&gt;&lt;/div&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCDC6;align=left;verticalAlign=top;fontFamily=Arial;"><mxGeometry x="920" y="70" width="260" height="240" as="geometry"/></mxCell><mxCell id="label3" value="Technical acceptance" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#123D38;"><mxGeometry x="20" y="380" width="1160" height="35" as="geometry"/></mxCell><mxCell id="label4" value="Human acceptance" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#216E75;"><mxGeometry x="430" y="380" width="750" height="35" as="geometry"/></mxCell><mxCell id="label5" value="Governance acceptance" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#123D38;"><mxGeometry x="815" y="380" width="365" height="35" as="geometry"/></mxCell><mxCell id="label6" value="Proposed schedule. No customer commitment or organizer requirement is implied." parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#A96827;"><mxGeometry x="20" y="447" width="1160" height="31" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Readiness support surrounds the field software" id="11-service-offering"><mxGraphModel dx="1200" dy="600" grid="1" page="1" pageScale="1" pageWidth="1200" pageHeight="600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="edge0" parent="1" source="a" target="b" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=3;strokeColor=#216E75;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" parent="1" source="b" target="c" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=3;strokeColor=#216E75;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a" value="&lt;div style=&quot;font-family:Arial;padding:12px;text-align:left&quot;&gt;&lt;div style=&quot;font-size:18px;color:#123D38&quot;&gt;INITIAL ENGAGEMENT&lt;/div&gt;&lt;div style=&quot;font-size:26px;font-weight:bold;margin-top:10px&quot;&gt;Prepare the exercise&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.3;margin-top:10px&quot;&gt;Workflow configuration&lt;br&gt;Devices and identities&lt;br&gt;Bundled maps&lt;br&gt;Bilingual training&lt;/div&gt;&lt;/div&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCDC6;align=left;verticalAlig